{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/route_hint.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route_hint.py\"",
            "async": false,
            "timeout": 10,
            "statusMessage": "iflytek-digital-human route and consent gate"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_guard.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_guard.py\"",
            "async": false,
            "timeout": 10,
            "statusMessage": "iflytek-digital-human consent gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_tracker.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_tracker.py\"",
            "async": false,
            "timeout": 5,
            "statusMessage": "iflytek-digital-human post-tool telemetry"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/response_guard.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/response_guard.py\"",
            "async": false,
            "timeout": 15,
            "statusMessage": "iflytek-digital-human response gate"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_tracker.py\"",
            "commandWindows": "py -3 \"${CLAUDE_PLUGIN_ROOT}/hooks/codex_tracker.py\"",
            "async": false,
            "timeout": 3,
            "statusMessage": "iflytek-digital-human session close"
          }
        ]
      }
    ]
  }
}
